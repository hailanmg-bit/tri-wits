{
  "name": "triwits",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "dev:lan": "vite --host",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0F3D35' --iconBackgroundColorDark '#0F3D35' --splashBackgroundColor '#0F3D35' --splashBackgroundColorDark '#0F3D35' --ios --android",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run cap:sync && cap open ios",
    "android": "npm run cap:sync && cap open android",
    "apk": "npm run cap:sync && sh scripts/android-env.sh assembleDebug",
    "aab": "npm run cap:sync && sh scripts/android-env.sh bundleRelease",
    "assets:draw": "node assets/src/make.cjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "preact": "^10.29.8"
  }
}
